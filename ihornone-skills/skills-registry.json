      "cli_tool": ["code-structure-verification", "naming-conventions", "testing-patterns", "git-workflow"],
      "library": ["naming-conventions", "testing-patterns", "api-documentation", "readme-template", "git-workflow"],
      "backend_api": ["error-handling-standards", "logging-standards", "security-checklist", "testing-patterns", "api-documentation"],
      "background_job": ["async-patterns-universal", "error-handling-standards", "logging-standards"]
    },
    "by_task": {
      "new_project": ["code-structure-verification", "naming-conventions", "git-workflow"],
      "security_review": ["security-checklist", "web-security"],
      "performance_review": ["performance-optimization", "web-performance"],
      "test_writing": ["testing-patterns"],
      "error_handling_review": ["error-handling-standards"],
      "logging_setup": ["logging-standards"],
      "api_documentation": ["api-documentation"],
      "readme_writing": ["readme-template"],
      "roadmap_planning": ["roadmap-template"]
    },
    "search_strategy": "1. Match user task keywords against skill 'triggers' array. 2. If project type is known, start with 'by_project_type' list. 3. Add universal skills needed for the task. 4. Never load skills from wrong platform layer."
  }
