---
import { getCollection } from 'astro:content';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<!-- Header Navbar -->
<nav class:list={['sticky top-0 z-50', className]} aria-label="Основна навігація">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="bg-paper-white border-2 border-black rounded-b-xl px-4 sm:px-5 py-3 flex items-center justify-between shadow-sm">
      <a href="/" class="text-2xl font-black text-ink-black tracking-tight shrink-0 no-underline" aria-label="ihornone - головна">ihornone</a>

      <!-- Desktop Navigation Menu -->
      <div class="hidden md:flex items-center gap-6" id="navbar-menu" role="menubar">
        <a href="/about" class:list={['nav-link', { active: currentPath === '/about' }]} role="menuitem">Про мене</a>
        
        <!-- Desktop Dropdown -->
        <div class="relative group py-3 -my-3" role="none">
          <a
            href="/services"
            class:list={['nav-link flex items-center gap-1.5 cursor-pointer bg-transparent border-none py-3', { active: currentPath.startsWith('/services') }]}
            role="menuitem"
          >
            Сервіси
            <i class="fa-solid fa-chevron-down text-[10px] group-hover:rotate-180 transition-transform duration-200" aria-hidden="true"></i>
          </a>
          <div
            class="hidden group-hover:block group-focus-within:block absolute top-full left-1/2 -translate-x-1/2 pt-1 z-50"
            role="menu"
          >
            <div class="bg-paper-white border-2 border-black rounded-xl p-2.5 flex items-center gap-2 whitespace-nowrap shadow-xl">
              {allServices.map((service, i) => (
                <>
                  {i > 0 && <span class="text-ink-black/20 font-bold" aria-hidden="true">·</span>}
                  <a href={`/services/${service.id}`} class="dropdown-link" role="menuitem">{service.data.title}</a>
                </>
              ))}
            </div>
          </div>
        </div>

        <a href="/portfolio" class:list={['nav-link', { active: currentPath.startsWith('/portfolio') }]} role="menuitem">Портфоліо</a>
        <a href="/reviews" class:list={['nav-link', { active: currentPath === '/reviews' }]} role="menuitem">Відгуки</a>
        
        <a href="/contacts" class="pill-btn-dark !py-2.5 !px-5 !text-sm font-bold shrink-0" aria-label="Замовити послугу">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          Замовити
        </a>
      </div>

      <!-- Minimal Mobile 3-Lines Burger Button -->
      <button
        type="button"
        id="mobile-burger-btn"
        class="md:hidden flex flex-col justify-center items-center gap-1.5 p-2 bg-transparent border-none cursor-pointer z-50 outline-none"
        aria-label="Відкрити меню"
      >
        <span class="burger-line block w-6 h-0.5 bg-ink-black rounded-full transition-all duration-300"></span>
        <span class="burger-line block w-6 h-0.5 bg-ink-black rounded-full transition-all duration-300"></span>
        <span class="burger-line block w-6 h-0.5 bg-ink-black rounded-full transition-all duration-300"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Slide-Up Bottom Drawer Sheet -->
<div id="mobile-drawer" class="mobile-drawer fixed inset-0 z-[200] md:hidden">
  <!-- Backdrop -->
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs"></div>

  <!-- Sheet Panel -->
  <div id="mobile-drawer-panel" class="fixed bottom-0 left-0 right-0 bg-paper-white border-t-2 border-black rounded-t-3xl shadow-2xl flex flex-col max-h-[85vh] z-[201] overflow-hidden">
    <!-- Drag Handle -->
    <div id="mobile-drawer-handle" class="pt-3.5 pb-2 flex justify-center bg-paper-white cursor-grab active:cursor-grabbing select-none shrink-0">
      <div class="w-12 h-1 bg-black/20 rounded-full hover:bg-black/40 transition-colors"></div>
    </div>

    <!-- Header -->
    <div class="px-6 pb-3 pt-1 flex items-center justify-between border-b border-black/10 shrink-0">
      <span class="text-xl font-black text-ink-black tracking-tight">ihornone</span>
      <span class="text-[10px] font-bold px-2.5 py-0.5 bg-morning-fog border border-black/10 rounded-full text-ink-black/70">
        Full-Stack Dev
      </span>
    </div>

    <!-- Links Content -->
    <div class="p-6 overflow-y-auto space-y-4 flex-1">
      <nav class="flex flex-col gap-1.5" aria-label="Мобільне меню">
        <a href="/" class:list={['mobile-drawer-link', { active: currentPath === '/' }]}>
          <i class="fa-solid fa-house text-sm w-5 text-center" aria-hidden="true"></i>
          Головна
        </a>
        <a href="/about" class:list={['mobile-drawer-link', { active: currentPath === '/about' }]}>
          <i class="fa-solid fa-user text-sm w-5 text-center" aria-hidden="true"></i>
          Про мене
        </a>

        <!-- Services Accordion -->
        <div class="flex flex-col rounded-xl overflow-hidden">
          <button
            type="button"
            id="mobile-drawer-services-btn"
            class="mobile-drawer-link flex items-center justify-between w-full text-left border-none bg-transparent cursor-pointer"
          >
            <span class="flex items-center gap-3">
              <i class="fa-solid fa-layer-group text-sm w-5 text-center" aria-hidden="true"></i>
              Сервіси
            </span>
            <i id="mobile-drawer-services-icon" class="fa-solid fa-chevron-down text-xs text-black/40 transition-transform duration-300" aria-hidden="true"></i>
          </button>
          <div id="mobile-drawer-services-list" class="hidden flex-col pl-6 pr-2 py-1 space-y-1 bg-morning-fog/50 rounded-xl my-1 border-l-2 border-black/30">
            <a href="/services" class="mobile-drawer-sublink">
              <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i> Усі послуги
            </a>
            {allServices.map((service) => (
              <a href={`/services/${service.id}`} class="mobile-drawer-sublink">
                <i class={`${service.data.icon} text-xs opacity-60`} aria-hidden="true"></i> {service.data.title}
              </a>
            ))}
          </div>
        </div>

        <a href="/portfolio" class:list={['mobile-drawer-link', { active: currentPath.startsWith('/portfolio') }]}>
          <i class="fa-solid fa-briefcase text-sm w-5 text-center" aria-hidden="true"></i>
          Портфоліо
        </a>
        <a href="/reviews" class:list={['mobile-drawer-link', { active: currentPath === '/reviews' }]}>
          <i class="fa-solid fa-star text-sm w-5 text-center" aria-hidden="true"></i>
          Відгуки
        </a>
      </nav>

      <!-- Action Button -->
      <div class="pt-4 border-t border-black/10">
        <a href="/contacts" class="pill-btn-dark w-full text-center justify-center !py-3.5 !text-base shadow-md no-underline font-bold flex items-center gap-2">
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
          Замовити проєкт
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Nav link styles */
  .nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-black);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-cobalt-pop);
  }

  .nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-paper-white), 0 0 0 4px var(--color-cobalt-pop);
    border-radius: 4px;
  }

  .dropdown-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-black);
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .dropdown-link:hover {
    background-color: var(--color-morning-fog);
    color: var(--color-cobalt-pop);
  }

  .dropdown-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-paper-white), 0 0 0 4px var(--color-cobalt-pop);
  }

  /* Drawer Animations without Tailwind Variable Conflicts */
  #mobile-drawer {
    pointer-events: none;
  }

  #mobile-drawer.is-open {
    pointer-events: auto !important;
  }

  #mobile-drawer-backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  #mobile-drawer.is-open #mobile-drawer-backdrop {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #mobile-drawer-panel {
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #mobile-drawer.is-open #mobile-drawer-panel {
    transform: translateY(0) !important;
  }

  .mobile-drawer-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink-black);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .mobile-drawer-link:hover, .mobile-drawer-link.active {
    background-color: var(--color-morning-fog);
  }

  .mobile-drawer-sublink {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-ink-black);
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .mobile-drawer-sublink:hover {
    background-color: var(--color-morning-fog);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const burgerBtn = document.getElementById('mobile-burger-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const closeBtn = document.getElementById('mobile-drawer-close-btn');
    const servicesBtn = document.getElementById('mobile-drawer-services-btn');
    const servicesList = document.getElementById('mobile-drawer-services-list');
    const servicesIcon = document.getElementById('mobile-drawer-services-icon');

    if (!drawer) return;

    function openDrawer() {
      drawer.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    burgerBtn?.addEventListener('click', openDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Auto-close on link click inside drawer
    const drawerLinks = drawer.querySelectorAll('a');
    drawerLinks.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    // Accordion Toggle
    servicesBtn?.addEventListener('click', function () {
      if (!servicesList || !servicesIcon) return;
      const isHidden = servicesList.classList.contains('hidden');
      if (isHidden) {
        servicesList.classList.remove('hidden');
        servicesList.classList.add('flex');
        servicesIcon.classList.add('rotate-180');
      } else {
        servicesList.classList.add('hidden');
        servicesList.classList.remove('flex');
        servicesIcon.classList.remove('rotate-180');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Touch Drag-to-Dismiss Gesture
    const handle = document.getElementById('mobile-drawer-handle');
    const panel = document.getElementById('mobile-drawer-panel');
    let startY = 0;
    let isDragging = false;

    if (handle && panel) {
      handle.addEventListener('touchstart', (e) => {
        startY = e.touches[0].clientY;
        isDragging = true;
        panel.style.transition = 'none';
      }, { passive: true });

      handle.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const currentY = e.touches[0].clientY;
        const deltaY = currentY - startY;
        if (deltaY > 0) {
          panel.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });

      handle.addEventListener('touchend', (e) => {
        if (!isDragging) return;
        isDragging = false;
        panel.style.transition = 'transform 0.3s cubic-bezier(0.16, 1, 0.3, 1)';
        const deltaY = e.changedTouches[0].clientY - startY;
        if (deltaY > 80) {
          closeDrawer();
        }
        panel.style.transform = '';
      });
    }
  });
</script>
