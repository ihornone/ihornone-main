---
const benefits = [
  {
    icon: 'fa-solid fa-bolt',
    title: 'MVP за 14–28 днів',
    desc: 'Швидкий запуск без бюрократії. Перший робочий прототип ви бачите вже в перший тиждень.',
    iconBg: 'bg-[#D09AFC]',
    borderHover: 'hover:border-[#D09AFC]',
  },
  {
    icon: 'fa-solid fa-comments',
    title: "Прямий зв'язок 1-на-1",
    desc: 'Жодних сейлзів чи менеджерів. Ви завжди спілкуєтеся напряму з автором вашого коду.',
    iconBg: 'bg-[#E8BA98]',
    borderHover: 'hover:border-[#E8BA98]',
  },
  {
    icon: 'fa-solid fa-coins',
    title: 'Чесний кошторис',
    desc: 'Ціна лише за чисту розробку. Ви не переплачуєте за оренду офісу та штат агентства.',
    iconBg: 'bg-[#FAC3C8]',
    borderHover: 'hover:border-[#FAC3C8]',
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: '30 днів підтримки',
    desc: "Після релізу залишаюся на зв'язку: безкоштовні виправлення та допомога після запуску.",
    iconBg: 'bg-[#D09AFC]',
    borderHover: 'hover:border-[#D09AFC]',
    hasMascot: true,
  },
];
---

<section id="advantages" class="space-y-8 sm:space-y-10 w-full" data-animate="fade-up">
  
  <!-- Section Title -->
  <div class="space-y-2">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#E8BA98] text-[#2A1E1E] shadow-2xs">
      <i class="fa-solid fa-star text-xs"></i>
      Чому я
    </span>
    <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
      Чому зі мною простіше, ніж в агентствах
    </h2>
    <p class="text-sm sm:text-base text-[#623A2D]/80 max-w-xl m-0 font-medium">
      Прозорі процеси, прямий контакт та швидкий результат без зайвих посередників.
    </p>
  </div>

  <!-- 4 Simple Benefit Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    {benefits.map((b) => (
      <div class:list={[
        'bento-card flex flex-col justify-between p-6 space-y-4 transition-all duration-300 relative group',
        b.borderHover
      ]}>
        {b.hasMascot && (
          <img
            src="/images/mascot/support-cat.png"
            alt="Маскот ihornone у худі сидить на картці підтримки"
            class="absolute -top-[70px] sm:-top-[82px] lg:-top-[106px] -right-3 sm:-right-5 lg:-right-8 w-24 sm:w-28 lg:w-36 h-auto pointer-events-none z-20 drop-shadow-md group-hover:-translate-y-1.5 transition-transform duration-300"
            loading="lazy"
          />
        )}
        <div class="space-y-3">
          <div class:list={['w-10 h-10 rounded-[10px] flex items-center justify-center text-sm font-black text-[#2A1E1E] shadow-2xs', b.iconBg]}>
            <i class={b.icon}></i>
          </div>
          <h3 class="text-lg font-black text-[#2A1E1E] tracking-tight m-0">
            {b.title}
          </h3>
        </div>
        <p class="text-xs sm:text-sm text-[#623A2D]/75 font-medium leading-relaxed m-0">
          {b.desc}
        </p>
      </div>
    ))}
  </div>

</section>
