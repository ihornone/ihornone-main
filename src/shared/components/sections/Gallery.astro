---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';

interface Props {
  photos: string[];
  title?: string;
  format?: '16:9' | '9:16';
  class?: string;
}

const {
  photos,
  title = 'Галерея проєкту',
  class: className = '',
} = Astro.props;

const initialCount = 3;
const hasMore = photos.length > initialCount;
const remainingCount = photos.length - initialCount;
---

{photos.length > 0 && (
  <section class:list={['w-full relative', className]} aria-label={title}>
    <Card class="space-y-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <SectionHeader title={title} class="m-0" />
          <span class="px-3 py-1 bg-morning-fog border border-black/5 text-ink-black/70 rounded-xl text-xs font-extrabold" role="status">
            {photos.length} фото
          </span>
        </div>
      </div>

      {/* Standard Grid / Masonry for all screens to prevent cropping/scrolling issues */}
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4" role="list">
        {photos.map((photoUrl, index) => {
          const isHidden = index >= initialCount;
          return (
            <div
              class={`break-inside-avoid rounded-2xl overflow-hidden border border-black/10 bg-morning-fog shadow-2xs hover:shadow-md transition-all duration-300 group cursor-pointer relative gallery-item ${isHidden ? 'hidden gallery-hidden' : ''}`}
              role="listitem"
              data-url={photoUrl}
              data-index={index}
            >
              <img
                src={photoUrl}
                alt={`Фото ${index + 1} з ${photos.length}`}
                class="w-full h-auto object-contain block"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300 flex items-end p-3 pointer-events-none">
                <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-paper-white/95 backdrop-blur-xs text-ink-black text-[10px] font-bold px-2.5 py-1 rounded-lg shadow-xs">
                  Збільшити <i class="fa-solid fa-expand ml-1" aria-hidden="true"></i>
                </span>
              </div>
            </div>
          );
        })}
      </div>

      {hasMore && (
        <div class="pt-2">
          <button
            id="gallery-toggle-btn"
            type="button"
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-morning-fog hover:bg-black/5 border border-black/10 text-ink-black text-sm font-bold transition-all duration-300 cursor-pointer shadow-2xs"
          >
            <span id="gallery-toggle-text">Показати решту фото ({remainingCount})</span>
            <i id="gallery-toggle-icon" class="fa-solid fa-chevron-down text-xs transition-transform duration-300"></i>
          </button>
        </div>
      )}
    </Card>

    {/* Lightbox Modal */}
    <div id="gallery-lightbox" class="fixed inset-0 z-[9999] bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-8">
      <button id="lightbox-close" class="absolute top-5 right-5 text-paper-white text-xl w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors cursor-pointer z-10" aria-label="Закрити">
        <i class="fa-solid fa-xmark"></i>
      </button>
      
      <button id="lightbox-prev" class="absolute left-4 sm:left-8 text-paper-white text-lg w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors cursor-pointer z-10" aria-label="Попереднє">
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <button id="lightbox-next" class="absolute right-4 sm:right-8 text-paper-white text-lg w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors cursor-pointer z-10" aria-label="Наступне">
        <i class="fa-solid fa-chevron-right"></i>
      </button>

      <div class="max-w-5xl max-h-[85vh] overflow-hidden flex items-center justify-center relative">
        <img id="lightbox-img" src="" alt="Збільшене фото" class="max-w-full max-h-[85vh] object-contain rounded-xl shadow-2xl" />
      </div>
    </div>
  </section>
)}

<script define:vars={{ photos, remainingCount }}>
  let currentIndex = 0;
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const toggleBtn = document.getElementById('gallery-toggle-btn');
  const toggleText = document.getElementById('gallery-toggle-text');
  const toggleIcon = document.getElementById('gallery-toggle-icon');
  const hiddenItems = document.querySelectorAll('.gallery-hidden');

  let isExpanded = false;

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      hiddenItems.forEach(item => {
        if (isExpanded) {
          item.classList.remove('hidden');
          // Add smooth transition effect
          item.style.opacity = '0';
          item.style.transform = 'translateY(10px)';
          requestAnimationFrame(() => {
            item.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          });
        } else {
          item.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
          item.style.opacity = '0';
          item.style.transform = 'translateY(10px)';
          setTimeout(() => {
            item.classList.add('hidden');
            item.style.transition = '';
            item.style.opacity = '';
            item.style.transform = '';
          }, 300);
          
          // Scroll back slightly to the top of gallery if collapsing and user is far down
          toggleBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      if (isExpanded) {
        if (toggleText) toggleText.textContent = 'Згорнути назад';
        if (toggleIcon) toggleIcon.classList.add('rotate-180');
      } else {
        if (toggleText) toggleText.textContent = `Показати решту фото (${remainingCount})`;
        if (toggleIcon) toggleIcon.classList.remove('rotate-180');
      }
    });
  }

  document.querySelectorAll('.gallery-item[data-url]').forEach(item => {
    item.addEventListener('click', () => {
      const url = item.getAttribute('data-url');
      const idx = parseInt(item.getAttribute('data-index') || '0', 10);
      window.openLightbox(url, idx);
    });
  });

  window.openLightbox = (url, index) => {
    currentIndex = index;
    if (lightbox && lightboxImg) {
      lightboxImg.src = url;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  };

  function closeLightbox() {
    if (lightbox) {
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  function showPhoto(index) {
    if (index < 0) currentIndex = photos.length - 1;
    else if (index >= photos.length) currentIndex = 0;
    else currentIndex = index;
    
    if (lightboxImg) {
      lightboxImg.src = photos[currentIndex];
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }
  if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); showPhoto(currentIndex - 1); });
  if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); showPhoto(currentIndex + 1); });

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
</script>
