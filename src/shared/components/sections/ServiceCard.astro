---
import Card from '../ui/Card.astro';
import IconBox from '../ui/IconBox.astro';
import Button from '../ui/Button.astro';

interface ServiceInclude {
  title: string;
}

interface Props {
  id: string;
  icon: string;
  title: string;
  description: string;
  includes?: ServiceInclude[];
  isPopular?: boolean;
  class?: string;
  startingPrice?: string;
}

const {
  id,
  icon,
  title,
  description,
  includes = [],
  isPopular = false,
  class: className = '',
  startingPrice = '',
} = Astro.props;
---

<article class:list={['relative h-full flex flex-col shrink-0 w-[85vw] sm:w-[320px] md:w-auto snap-center md:snap-align-none pt-4 overflow-visible', className]}>
  <Card hover variant={isPopular ? 'highlight' : 'default'} class="h-full flex flex-col justify-between min-h-[460px] relative overflow-visible">
    {isPopular && (
      <div class="absolute -top-3.5 right-6 bg-[#D09AFC] text-[#2A1E1E] text-[10px] font-black uppercase tracking-wider px-3.5 py-1 rounded-[10px] shadow-2xs z-30 whitespace-nowrap" role="status">
        Популярний напрямок
      </div>
    )}

    <div class="flex-1 flex flex-col">
      <!-- Icon -->
      <div class="mb-4">
        <IconBox icon={icon} size="lg" />
      </div>

      <!-- Title & Description with Fixed Equal Heights -->
      <div class="space-y-2 mb-4">
        <h3 class="text-xl font-black text-[#2A1E1E] m-0 min-h-[3.25rem] flex items-center">
          {title}
        </h3>
        <p class="text-sm text-[#623A2D]/80 font-medium leading-relaxed m-0 min-h-[2.5rem]">
          {description}
        </p>
      </div>

      <!-- Starting Price Badge -->
      {startingPrice && (
        <div class="mb-4 inline-flex items-center justify-between w-full px-3.5 py-2 rounded-[8px] bg-[#FAF1EC] border border-[#623A2D]/10">
          <span class="text-xs font-semibold text-[#623A2D]/70">Орієнтовна вартість:</span>
          <span class="text-xs font-black text-[#2A1E1E] bg-white px-2 py-0.5 rounded-[6px] border border-[#623A2D]/10 shadow-2xs">
            {startingPrice}
          </span>
        </div>
      )}

      <!-- Included Features List -->
      {includes.length > 0 && (
        <ul class="space-y-2.5 pt-4 border-t border-[#623A2D]/10 list-none p-0 m-0 flex-1 flex flex-col justify-start" role="list" aria-label={`Що входить у послугу: ${title}`}>
          {includes.slice(0, 4).map((item) => (
            <li class="flex items-center gap-2.5 text-xs font-bold text-[#2A1E1E]/90">
              <i class="fa-solid fa-circle-check text-[#D09AFC] text-xs shrink-0" aria-hidden="true"></i>
              <span>{item.title}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Bottom Action Button Always Aligned at Bottom -->
    <div class="pt-5 mt-auto">
      <Button href={`/services/${id}`} variant="primary" class="w-full text-center justify-center" ariaLabel={`Детальніше про ${title}`}>
        Детальніше <i class="fa-solid fa-arrow-right text-xs ml-1" aria-hidden="true"></i>
      </Button>
    </div>
  </Card>
</article>
