---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface Props {
  badge?: {
    text: string;
    icon?: string;
  };
  title: string;
  subtitle?: string;
  buttons?: {
    label: string;
    href: string;
    variant?: 'primary' | 'outline' | 'dark';
    icon?: string;
  }[];
  align?: 'left' | 'center';
  class?: string;
}

const {
  badge,
  title,
  subtitle,
  buttons = [],
  align = 'center',
  class: className = '',
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center',
};

const contentAlignClasses = {
  left: 'items-start',
  center: 'items-center',
};
---

<section class={`w-full py-8 md:py-12 ${className}`}>
  <div class={`flex flex-col ${contentAlignClasses[align]} gap-5 max-w-3xl ${align === 'center' ? 'mx-auto' : ''}`}>
    
    {badge && (
      <Badge icon={badge.icon}>
        {badge.text}
      </Badge>
    )}

    <h1 class={`text-3xl sm:text-4xl md:text-5xl font-black text-ink-black tracking-tight leading-tight m-0 ${alignClasses[align]}`}>
      {title}
    </h1>

    {subtitle && (
      <p class={`text-base sm:text-lg text-black/65 leading-relaxed m-0 ${alignClasses[align]}`}>
        {subtitle}
      </p>
    )}

    {buttons.length > 0 && (
      <div class={`flex flex-wrap ${align === 'center' ? 'justify-center' : ''} gap-3.5 pt-2`}>
        {buttons.map((button) => (
          <Button
            href={button.href}
            variant={button.variant || 'dark'}
            size="lg"
            icon={button.icon}
          >
            {button.label}
          </Button>
        ))}
      </div>
    )}

    <slot />
  </div>
</section>
