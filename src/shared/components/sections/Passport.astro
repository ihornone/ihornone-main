---
interface PassportField {
  label: string;
  value: string;
}

interface Props {
  title?: string;
  fields: PassportField[];
  class?: string;
}

const {
  title = 'Паспорт проєкту',
  fields,
  class: className = '',
} = Astro.props;
---

<div class={`pt-6 border-t border-black/10 ${className}`}>
  <div class="flex items-center justify-between pb-3">
    <span class="text-[11px] sm:text-xs font-black text-black/40 uppercase tracking-widest block">
      {title}
    </span>
  </div>
  
  <div class="flex sm:grid overflow-x-auto sm:overflow-x-visible snap-x sm:snap-none pb-2 sm:pb-0 scrollbar-none sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-12 gap-3 text-left">
    {fields.map((field, index) => {
      // 7 fields: first 4 take col-span-3 (4 * 3 = 12), last 3 take col-span-4 (3 * 4 = 12)
      const isFirstFour = index < 4;
      const spanClass = isFirstFour ? 'lg:col-span-3' : 'lg:col-span-4';
      return (
        <div class={`bg-paper-white border border-black/5 rounded-2xl p-4 sm:p-5 flex flex-col justify-between space-y-1.5 min-w-[150px] sm:min-w-0 snap-start shrink-0 sm:shrink shadow-2xs ${spanClass}`}>
          <span class="text-[10px] sm:text-[11px] font-extrabold text-black/40 uppercase tracking-wider block">
            {field.label}
          </span>
          <strong class="text-xs sm:text-sm font-bold text-ink-black block leading-snug" title={field.value}>
            {field.value}
          </strong>
        </div>
      );
    })}
  </div>
</div>
