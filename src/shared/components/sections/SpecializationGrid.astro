---
import Card from '../ui/Card.astro';
import IconBox from '../ui/IconBox.astro';
import { getCollection } from 'astro:content';

interface Props {
  class?: string;
}

const {
  class: className = '',
} = Astro.props;

const allItems = (await getCollection('specializations')).sort((a, b) => a.data.order - b.data.order);
---

<div class={`w-full ${className}`}>
  <div class="grid grid-rows-2 grid-flow-col auto-cols-[82vw] sm:auto-cols-auto sm:grid-rows-none sm:grid-flow-row sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-3.5 overflow-x-auto sm:overflow-visible snap-x snap-mandatory sm:snap-none -mx-4 px-4 sm:mx-0 sm:px-0 pt-1 pb-3 sm:pb-0 scrollbar-none scroll-pl-4 sm:scroll-pl-0 items-stretch" data-animate="fade-up" data-stagger>
    {allItems.map((item) => (
      <button
        type="button"
        class="spec-item bg-white border border-[#623A2D]/10 rounded-[10px] p-3.5 sm:p-4 flex items-center gap-3.5 text-left transition-all hover:border-[#D09AFC] hover:shadow-md hover:-translate-y-0.5 cursor-pointer snap-start w-full"
        data-title={item.data.title}
        data-desc={item.data.fullDescription || item.data.desc}
        data-icon={item.data.icon}
      >
        <div class="shrink-0">
          <IconBox icon={item.data.icon} size="md" variant="accent" />
        </div>
        <div class="min-w-0 flex-1">
          <strong class="text-sm sm:text-base font-black text-[#2A1E1E] block leading-tight">{item.data.title}</strong>
          <span class="text-xs text-[#623A2D]/70 block leading-tight mt-1">{item.data.desc}</span>
        </div>
      </button>
    ))}
  </div>
</div>

<dialog
  id="spec-drawer"
  class="fixed inset-0 z-[200] bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full opacity-0 pointer-events-none backdrop:bg-black/50"
>
  <div class="drawer-content h-full flex flex-col md:flex-row justify-end">
    <div class="drawer-backdrop absolute inset-0" aria-hidden="true"></div>
    <div class="drawer-panel relative bg-paper-white h-full w-full max-w-md flex flex-col shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-black/5 shrink-0">
        <div class="flex items-center gap-3">
          <div id="spec-drawer-icon"></div>
          <h3 id="spec-drawer-title" class="text-lg font-bold text-ink-black m-0"></h3>
        </div>
        <button
          type="button"
          class="js-close-spec w-9 h-9 rounded-full bg-morning-fog flex items-center justify-center text-ink-black/60 hover:text-ink-black transition-colors cursor-pointer border-none"
          aria-label="Закрити"
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto overscroll-contain px-6 py-5">
        <p id="spec-drawer-desc" class="text-sm sm:text-base text-black/70 leading-relaxed m-0"></p>
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0);
    transition: background 0.3s;
  }

  dialog[open]::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  dialog[open] .drawer-panel {
    transform: translateX(0);
  }

  .drawer-content {
    position: relative;
    height: 100%;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
  }

  .drawer-panel {
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overscroll-behavior: contain;
  }

  @media (max-width: 767px) {
    dialog[open] .drawer-panel {
      transform: translateY(0);
    }

    .drawer-panel {
      transform: translateY(100%);
      max-height: 70vh;
      border-radius: 1rem 1rem 0 0;
      margin-top: auto;
    }

    .drawer-content {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    .drawer-backdrop {
      position: fixed;
    }
  }

  @media (min-width: 768px) {
    .drawer-panel {
      max-height: none;
      border-top-left-radius: 1rem;
      border-bottom-left-radius: 1rem;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById('spec-drawer') as HTMLDialogElement;
    const titleEl = document.getElementById('spec-drawer-title');
    const iconEl = document.getElementById('spec-drawer-icon');
    const descEl = document.getElementById('spec-drawer-desc');
    const items = document.querySelectorAll('.spec-item');
    const closeBtns = document.querySelectorAll('.js-close-spec');
    const backdrop = dialog?.querySelector('.drawer-backdrop');

    function open(title: string, desc: string, icon: string) {
      if (!dialog || !titleEl || !descEl || !iconEl) return;
      titleEl.textContent = title;
      descEl.textContent = desc;
      iconEl.innerHTML = `<div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background-color: var(--color-kofi-blue, #e8e4d8);"><i class="${icon} text-base" style="color: var(--color-cobalt-pop, #3b5bdb);"></i></div>`;
      dialog.showModal();
      dialog.style.opacity = '1';
      dialog.style.pointerEvents = 'auto';
      document.body.style.overflow = 'hidden';
    }

    function close() {
      if (!dialog) return;
      dialog.style.opacity = '0';
      dialog.style.pointerEvents = 'none';
      dialog.close();
      document.body.style.overflow = '';
    }

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-desc') || '';
        const icon = item.getAttribute('data-icon') || '';
        open(title, desc, icon);
      });
    });

    closeBtns.forEach(btn => btn.addEventListener('click', close));
    backdrop?.addEventListener('click', close);

    dialog?.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
  });
</script>
