---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  class:list={[
    "relative w-full h-[100dvh] min-h-[640px] overflow-hidden",
    className,
  ]}
>
  <!-- Fullscreen Edge-to-Edge Background Image -->
  <div class="absolute inset-0 w-full h-full z-0">
    <img
      src="/images/mascot/hero-cat.webp"
      alt="Dev-кіт ihornone у чорному худі за макбуком"
      class="w-full h-full object-cover object-center sm:object-[center_35%] scale-100 hero-ambient-zoom"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Subtle overall cinematic vignette -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#2A1E1E]/40 via-transparent to-transparent pointer-events-none"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#2A1E1E]/80 via-transparent to-transparent pointer-events-none"
    >
    </div>
  </div>

  <!-- Center-Left Text Block with seamless feathered blur glow behind text -->
  <div
    class="absolute top-1/2 -translate-y-1/2 left-6 sm:left-10 lg:left-14 z-10 max-w-xl lg:max-w-2xl text-left pointer-events-auto animate-hero-fade-in"
  >
    <!-- Seamless soft blur & dark glow behind text (no rectangle borders) -->
    <div class="absolute -inset-6 sm:-inset-10 backdrop-blur-md bg-[#2A1E1E]/50 [mask-image:radial-gradient(ellipse_at_center,black_45%,transparent_80%)] pointer-events-none -z-10"></div>

    <div class="space-y-4">
      <!-- Trust Benefit Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[#FAF1EC] text-xs font-bold shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[#D09AFC] animate-ping"></span>
        <span>Розробка для бізнесу • Старт від 3 700 ₴ • MVP за 14–28 днів</span>
      </div>

      <h1
        class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08] m-0 drop-shadow-md"
      >
        Сайти, боти та сервіси, які <span class="text-[#D09AFC]">приносять заявки</span> й автоматизують бізнес
      </h1>
      
      <p
        class="text-sm sm:text-base lg:text-lg text-[#FAF1EC]/90 leading-relaxed font-medium m-0 max-w-lg drop-shadow-sm"
      >
        Перетворюю трафік на клієнтів, а рутину — на автономні продажі 24/7. Працюєте напряму з розробником: фіксований кошторис, чистий код та запуск першого прототипу вже за 5 днів.
      </p>

      <!-- Quick Benefit Bullets -->
      <div class="pt-2 flex flex-wrap gap-x-4 gap-y-2 text-xs font-bold text-[#FAF1EC]/85">
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-[#D09AFC]"></i> Більше продажів та лідів
        </span>
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-[#D09AFC]"></i> -70% рутинної роботи
        </span>
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check text-[#D09AFC]"></i> 30 днів повної гарантії
        </span>
      </div>
    </div>
  </div>

  <!-- Bottom-Right Carved Buttons Pocket (Immediate 100% visibility on load) -->
  <div class="absolute bottom-0 right-0 z-20 pointer-events-auto">
    <div
      class="relative bg-[#FAF1EC] rounded-tl-[10px] px-4 sm:px-5 py-3 sm:py-3.5 shadow-md flex items-center gap-3"
    >
      <!-- Inverted Scoop Curve (Above the plate along the right edge: curves smoothly inwards) -->
      <svg
        class="absolute -top-[10px] right-0 w-[10px] h-[10px] pointer-events-none"
        viewBox="0 0 10 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M10 10 V0 A 10 10 0 0 1 0 10 H10 Z" fill="#FAF1EC"></path>
      </svg>

      <!-- Inverted Scoop Curve (To the left of the plate along the bottom edge: curves smoothly inwards) -->
      <svg
        class="absolute bottom-0 -left-[10px] w-[10px] h-[10px] pointer-events-none"
        viewBox="0 0 10 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M10 10 H0 A 10 10 0 0 0 10 0 V10 Z" fill="#FAF1EC"></path>
      </svg>

      <!-- Lavender Primary Button with Pulse Glow (10px rounded) -->
      <a
        href="https://t.me/ihornone"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-[10px] font-black text-xs sm:text-sm px-5 py-2.5 bg-[#D09AFC] text-[#2A1E1E] animate-pulse-glow hover:bg-[#BF80FA] hover:-translate-y-0.5 active:translate-y-0 transition-all no-underline group"
      >
        <i
          class="fa-brands fa-telegram text-[#2A1E1E] text-base group-hover:scale-110 transition-transform"
        ></i>
        <span>Обговорити в Telegram</span>
        <i class="fa-solid fa-arrow-right text-[10px] text-[#2A1E1E]"></i>
      </a>

      <!-- Dark Contrast Button (10px rounded) -->
      <a
        href="/portfolio"
        class="inline-flex items-center justify-center gap-2 rounded-[10px] font-bold text-xs sm:text-sm px-5 py-2.5 bg-[#2A1E1E] hover:bg-[#3D2C2C] text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all no-underline"
      >
        <span>Дивитися кейси</span>
        <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-75"
        ></i>
      </a>
    </div>
  </div>

  <!-- Subtle Scroll Down Indicator in Lavender Accent -->
  <a
    href="#services"
    class="absolute bottom-4 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1 text-[#D09AFC]/80 hover:text-white transition-colors no-underline text-[10px] font-black uppercase tracking-widest"
    aria-label="Гортати вниз"
  >
    <i class="fa-solid fa-chevron-down text-xs animate-bounce"></i>
  </a>
</section>
