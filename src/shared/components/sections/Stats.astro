---
interface StatItem {
  value: string;
  label: string;
  subtext?: string;
  link?: { text: string; href: string };
}

interface Props {
  items?: StatItem[];
  variant?: 'default' | 'accent';
  columns?: 2 | 3 | 4 | 5;
  class?: string;
}

const defaultItems: StatItem[] = [
  { value: '100%', label: 'прозорий процес', link: { text: 'Дивитись кейси', href: '/portfolio' } },
  { value: '3+', label: 'роки досвіду' },
  { value: '14-28', label: 'днів на запуск MVP' },
  { value: '30 днів', label: 'гарантійної підтримки' },
];

const {
  items = defaultItems,
  variant = 'default',
  columns = 4,
  class: className = '',
} = Astro.props;

const variantClasses = {
  default: 'bg-white border border-[#623A2D]/10 shadow-2xs',
  accent: 'bg-[#FAF1EC] border border-[#623A2D]/10 shadow-2xs',
};

const columnsClasses = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 sm:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-4',
  5: 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5',
};
---

<section class={`rounded-[10px] p-6 sm:p-8 md:p-10 w-full ${variantClasses[variant]} ${className}`} data-animate="fade-up">
  <div class={`grid ${columnsClasses[columns]} gap-6 text-center`} data-animate="fade-up" data-stagger>
    {items.map((item) => (
      <div class="space-y-1 flex flex-col items-center justify-center">
        <div class="text-3xl md:text-4xl font-black text-[#2A1E1E] tracking-tight">
          {item.value}
        </div>
        <div class="text-xs font-bold text-[#623A2D]/75 uppercase tracking-wider">
          {item.label}
        </div>
        {item.subtext && (
          <p class="text-[11px] text-[#623A2D]/60 font-medium m-0">{item.subtext}</p>
        )}
        {item.link && (
          <a href={item.link.href} class="inline-flex items-center gap-1 text-[11px] font-bold text-[#95553C] hover:text-[#2A1E1E] transition-colors mt-0.5 no-underline">
            <span>{item.link.text}</span>
            <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </a>
        )}
      </div>
    ))}
  </div>
</section>
