---
interface Props {
  icon: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'accent' | 'muted';
  class?: string;
}

const {
  icon,
  size = 'md',
  variant = 'default',
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'w-9 h-9 text-base',
  md: 'w-11 h-11 text-lg',
  lg: 'w-14 h-14 text-2xl',
};

const variantClasses = {
  default: 'bg-kofi-blue/40 text-ink-black',
  accent: 'bg-paper-white text-cobalt-pop shadow-2xs',
  muted: 'bg-morning-fog text-cobalt-pop',
};

const baseClasses = 'rounded-xl flex items-center justify-center shrink-0';
---

<div class={`${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`}>
  <i class={icon}></i>
</div>
