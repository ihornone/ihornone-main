---
interface Props {
  icon: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'default' | 'accent' | 'muted';
  class?: string;
}

const {
  icon,
  size = 'md',
  variant = 'default',
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'w-9 h-9 text-base',
  md: 'w-11 h-11 text-lg',
  lg: 'w-14 h-14 text-2xl',
};

const variantClasses = {
  default: 'bg-[#FAF1EC] text-[#2A1E1E] border border-[#623A2D]/10',
  accent: 'bg-[#D09AFC] text-[#2A1E1E] shadow-2xs',
  muted: 'bg-[#FAF1EC] text-[#623A2D]',
};

const baseClasses = 'rounded-[10px] flex items-center justify-center shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3';
---

<div class={`${baseClasses} ${sizeClasses[size]} ${variantClasses[variant]} ${className}`}>
  <i class={icon}></i>
</div>
