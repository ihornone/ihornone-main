---
interface Props {
  variant?: 'default' | 'highlight' | 'flat';
  padding?: 'sm' | 'md' | 'lg';
  hover?: boolean;
  as?: 'div' | 'article' | 'section' | 'aside';
  class?: string;
}

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  as: Tag = 'div',
  class: className = '',
} = Astro.props;

const variantClasses = {
  default: 'bg-white border border-[#623A2D]/10 shadow-2xs',
  highlight: 'bg-white border-2 border-[#D09AFC] shadow-md',
  flat: 'bg-[#FAF1EC] border border-[#623A2D]/10',
};

const paddingClasses = {
  sm: 'p-4 sm:p-5',
  md: 'p-5 sm:p-7 md:p-8',
  lg: 'p-6 sm:p-8 md:p-10',
};

const baseClasses = 'rounded-[10px] transition-all duration-300';
const hoverClasses = hover ? 'hover:border-[#D09AFC] hover:shadow-xl hover:-translate-y-1' : '';
---

<Tag class:list={[baseClasses, variantClasses[variant], paddingClasses[padding], hoverClasses, className]}>
  <slot />
</Tag>
