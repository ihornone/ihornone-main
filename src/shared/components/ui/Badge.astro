---
interface Props {
  variant?: 'default' | 'accent' | 'success' | 'muted';
  icon?: string;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'default',
  icon,
  class: className = '',
  ariaLabel,
} = Astro.props;

const variantClasses = {
  default: 'bg-kofi-blue/30 text-ink-black',
  accent: 'bg-cobalt-pop text-paper-white',
  success: 'bg-green-500/10 text-green-700 border border-green-500/20',
  muted: 'bg-morning-fog text-ink-black/70 border border-black/5',
};

const baseClasses = 'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider';
---

<span class:list={[baseClasses, variantClasses[variant], className]} role={ariaLabel ? 'status' : undefined} aria-label={ariaLabel}>
  {icon && <i class={icon} aria-hidden="true"></i>}
  <slot />
</span>
