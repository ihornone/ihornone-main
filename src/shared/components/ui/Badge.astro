---
interface Props {
  variant?: 'default' | 'accent' | 'success' | 'muted';
  icon?: string;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'default',
  icon,
  class: className = '',
  ariaLabel,
} = Astro.props;

const variantClasses = {
  default: 'bg-[#E8BA98] text-[#2A1E1E] shadow-2xs',
  accent: 'bg-[#D09AFC] text-[#2A1E1E] shadow-2xs',
  pink: 'bg-[#FAC3C8] text-[#2A1E1E] shadow-2xs',
  success: 'bg-emerald-500/10 text-emerald-800 border border-emerald-500/20',
  muted: 'bg-[#FAF1EC] text-[#623A2D] border border-[#623A2D]/10',
};

const baseClasses = 'inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider';
---

<span class:list={[baseClasses, variantClasses[variant], className]} role={ariaLabel ? 'status' : undefined} aria-label={ariaLabel}>
  {icon && <i class={icon} aria-hidden="true"></i>}
  <slot />
</span>
