---
interface Props {
  variant?: 'primary' | 'outline' | 'dark' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  disabled?: boolean;
  loading?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  ariaLabel?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  disabled = false,
  loading = false,
  icon,
  iconPosition = 'right',
  ariaLabel,
  target,
  rel,
} = Astro.props;

const isDisabled = disabled || loading;

const variantClasses = {
  primary: 'bg-[#2A1E1E] text-white rounded-[10px] shadow-sm hover:bg-[#3D2C2C] hover:-translate-y-0.5 hover:shadow-md focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  outline: 'bg-[#FAF1EC]/90 text-[#2A1E1E] border border-[#623A2D]/15 rounded-[10px] hover:bg-[#FAF1EC] hover:border-[#623A2D]/30 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  dark: 'bg-[#2A1E1E] text-white rounded-[10px] shadow-sm hover:bg-[#3D2C2C] hover:-translate-y-0.5 hover:shadow-md focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  ghost: 'bg-transparent text-[#2A1E1E] hover:bg-[#FAF1EC] rounded-[10px] focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
  accent: 'bg-[#D09AFC] text-[#2A1E1E] rounded-[10px] shadow-sm hover:bg-[#BF80FA] hover:-translate-y-0.5 hover:shadow-md focus-visible:ring-2 focus-visible:ring-[#D09AFC]',
};

const sizeClasses = {
  sm: '!py-2 !px-4 !text-xs',
  md: '!py-3 !px-6 !text-sm',
  lg: '!py-3.5 !px-8 !text-base',
};

const baseClasses = 'inline-flex items-center justify-center gap-2 rounded-[10px] font-sans font-bold transition-all duration-200 cursor-pointer no-underline outline-none';
---

{href ? (
  <a
    href={href}
    target={target}
    rel={rel || (target === '_blank' ? 'noopener noreferrer' : undefined)}
    class={`${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${isDisabled ? 'opacity-50 pointer-events-none' : ''} ${className}`}
    aria-label={ariaLabel}
    aria-disabled={isDisabled}
    tabindex={isDisabled ? -1 : 0}
  >
    {loading ? (
      <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    ) : (
      icon && iconPosition === 'left' && <i class={`${icon} text-xs`} aria-hidden="true"></i>
    )}
    <slot />
    {!loading && icon && iconPosition === 'right' && <i class={`${icon} text-xs`} aria-hidden="true"></i>}
  </a>
) : (
  <button
    type={type}
    disabled={isDisabled}
    class={`${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${isDisabled ? 'opacity-50 cursor-not-allowed' : ''} ${className}`}
    aria-label={ariaLabel}
    aria-busy={loading}
    aria-disabled={isDisabled}
  >
    {loading ? (
      <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    ) : (
      icon && iconPosition === 'left' && <i class={`${icon} text-xs`} aria-hidden="true"></i>
    )}
    <slot />
    {!loading && icon && iconPosition === 'right' && <i class={`${icon} text-xs`} aria-hidden="true"></i>}
  </button>
)}
