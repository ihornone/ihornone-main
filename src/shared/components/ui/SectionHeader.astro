---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  title,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center max-w-xl mx-auto',
};
---

<div class={`${alignClasses[align]} space-y-1.5 ${className}`}>
  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
    {title}
  </h2>
  {subtitle && (
    <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium m-0 mt-1 max-w-xl">
      {subtitle}
    </p>
  )}
</div>
