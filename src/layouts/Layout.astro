---
import Navbar from '../shared/components/layout/Navbar.astro';
import Footer from '../shared/components/layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: string;
  structuredData?: object;
}

const {
  title = 'ihornone — Telegram-боти, Веб-сайти, Мобільні додатки',
  description = 'Розробка Telegram-ботів, мобільних додатків та веб-сайтів будь-якої складності. Повний цикл від ідеї до запуску з високою конверсією.',
  image = '/og-image.png',
  url = 'https://ihornone.site',
  type = 'website',
  structuredData,
} = Astro.props;

const siteName = 'ihornone';
const fullUrl = url.startsWith('http') ? url : `https://ihornone.site${url}`;
const fullImageUrl = image.startsWith('http') ? image : `https://ihornone.site${image}`;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <!-- Primary SEO & GEO / AI Optimization -->
    <meta name="description" content={description} />
    <meta name="author" content="ihornone" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Geographic & Regional Targeting (GEO) -->
    <meta name="geo.region" content="UA" />
    <meta name="geo.placename" content="Ukraine" />
    <meta name="geo.position" content="49.8397;24.0297" />
    <meta name="ICBM" content="49.8397, 24.0297" />
    <meta name="coverage" content="Worldwide" />
    <meta name="distribution" content="Global" />

    <!-- AI & LLM Engine Context Metadata -->
    <meta name="application-name" content="ihornone Portfolio & Engineering" />
    <meta name="keywords" content="розробка сайтів, створення telegram ботів, розробка мобільних додатків, web development, telegram bot developer, react native, astro, node.js, full-stack розробник, ihornone, сайти для бізнесу, чат-боти з оплатою" />
    <meta name="rating" content="General" />

    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="uk_UA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:creator" content="@ihornone" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#FAF1EC" />
    <meta name="color-scheme" content="light" />

    <!-- Global Base Schema for AI Engine Knowledge Graphs -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://ihornone.site/#person",
          "name": "ihornone",
          "url": "https://ihornone.site",
          "image": "https://ihornone.site/favicon.svg",
          "jobTitle": "Full-Stack Software Engineer & AI Integrator",
          "knowsAbout": [
            "Telegram Bots Architecture",
            "Web Development",
            "Mobile Apps Development",
            "React Native",
            "Astro",
            "Node.js",
            "TypeScript",
            "UI/UX Design",
            "API & Payment Gateways Integration"
          ],
          "sameAs": [
            "https://t.me/ihornone",
            "https://github.com/ihornone",
            "https://instagram.com/ihornone",
            "https://threads.net/@ihornone"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://ihornone.site/#website",
          "url": "https://ihornone.site",
          "name": "ihornone — Розробка Telegram-ботів, веб-сайтів та мобільних додатків",
          "description": "Індивідуальна розробка Telegram-ботів, сучасних веб-сервісів та мобільних додатків з гарантією та підтримкою.",
          "publisher": { "@id": "https://ihornone.site/#person" },
          "inLanguage": "uk-UA"
        }
      ]
    })} />

    <!-- Client Router for instant millisecond transitions -->
    <ClientRouter />

    {isHome && (
      <link rel="preload" as="image" href="/images/mascot/hero-cat.webp" type="image/webp" fetchpriority="high" />
    )}

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-oat-cream text-ink-black font-sans min-h-screen antialiased flex flex-col">
    <a href="#main-content" class="skip-link">Перейти до основного вмісту</a>
    <Navbar />
    <main id="main-content" class:list={['flex-grow', { 'pt-20 sm:pt-24 lg:pt-24': !isHome }]}>
      <slot />
    </main>
    <Footer />
  </body>

  <script>
    // Lightweight Intersection Observer for scroll animations (pre-triggers 80px before entering screen)
    function initScrollAnimations() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: '80px 0px 80px 0px' }
      );

      document.querySelectorAll('[data-animate]').forEach((el) => {
        observer.observe(el);
      });
    }

    document.addEventListener('astro:page-load', initScrollAnimations);
  </script>
</html>
