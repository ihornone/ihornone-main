---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className = '' } = Astro.props;
---

<a
  href={`/portfolio/${project.id}`}
  class:list={[
    'project-card group flex flex-col justify-between rounded-[10px] overflow-hidden border border-[#623A2D]/10 bg-white shadow-2xs hover:border-[#D09AFC] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 no-underline text-[#2A1E1E]',
    className
  ]}
  data-category={project.category}
>
  <!-- Card Image Header -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#FAF1EC]">
    <img
      src={project.image}
      alt={project.title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute top-3.5 left-3.5 z-10 flex items-center gap-2">
      <span class="bg-[#2A1E1E]/85 backdrop-blur-md text-white text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-[10px] shadow-xs">
        {project.category}
      </span>
    </div>
    <div class="absolute top-3.5 right-3.5 z-10 w-8 h-8 rounded-[10px] bg-white/95 backdrop-blur-md flex items-center justify-center text-[#2A1E1E] text-xs shadow-xs group-hover:scale-110 transition-transform">
      <i class={project.icon}></i>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between space-y-4">
    <div class="space-y-2">
      <h3 class="text-base sm:text-lg font-black text-[#2A1E1E] m-0 tracking-tight leading-snug group-hover:text-[#95553C] transition-colors">
        {project.title}
      </h3>
      <p class="text-xs sm:text-sm text-[#623A2D]/75 leading-relaxed font-medium m-0 line-clamp-2">
        {project.description}
      </p>
    </div>

    <!-- Technologies & Action -->
    <div class="pt-3 border-t border-[#623A2D]/10 flex items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {project.meta?.technologies && (
          project.meta.technologies.split(',').slice(0, 2).map((tech) => (
            <span class="bg-[#FAF1EC] text-[#2A1E1E] border border-[#623A2D]/10 text-[10px] font-bold px-2 py-0.5 rounded-[6px]">
              {tech.trim()}
            </span>
          ))
        )}
      </div>

      <span class="inline-flex items-center gap-1.5 text-xs font-black text-[#2A1E1E] group-hover:text-[#95553C] group-hover:translate-x-1 transition-all">
        <span>Кейс</span>
        <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </span>
    </div>
  </div>
</a>
