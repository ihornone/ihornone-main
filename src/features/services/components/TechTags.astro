---
import Card from '../../../shared/components/ui/Card.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;

const businessBenefits = [
  {
    icon: 'fa-solid fa-gauge-high',
    title: 'Швидкість завантаження < 1с',
    desc: 'Сучасні фреймворки дають миттєвий відгук на телефонах. Користувачі не йдуть до конкурентів через очікування.',
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: '99.9% доступність та безпека',
    desc: 'Глобальні хмарні платформи (Cloudflare, AWS) захищають від збоїв, хакерських атак та витримують сплески трафіку.',
  },
  {
    icon: 'fa-solid fa-coins',
    title: 'Економія на утриманні серверів',
    desc: 'Оптимальна архітектура не вимагає дорогих серверів щомісяця — ви заощаджуєте на технічній підтримці.',
  },
];
---

{technologies && technologies.length > 0 && (
  <section class="space-y-6 w-full" data-animate="fade-up">
    <SectionHeader
      title="Технологічний стек та що це дає вашому бізнесу"
      subtitle="Я не просто пишу код — я підбираю технології, які роблять ваш продукт швидким, надійним та економним в утриманні."
    />

    <!-- 3 Business Value Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {businessBenefits.map((b) => (
        <Card class="p-5 space-y-2.5 bg-white border border-[#623A2D]/10">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-[8px] bg-[#FAF1EC] text-[#95553C] flex items-center justify-center text-sm shrink-0 border border-[#623A2D]/10">
              <i class={b.icon}></i>
            </div>
            <strong class="text-sm font-black text-[#2A1E1E] leading-tight">{b.title}</strong>
          </div>
          <p class="text-xs text-[#623A2D]/75 font-medium m-0 leading-relaxed">
            {b.desc}
          </p>
        </Card>
      ))}
    </div>

    <!-- Tech Tags List -->
    <div class="p-4 sm:p-5 rounded-[10px] bg-[#FAF1EC]/60 border border-[#623A2D]/10 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold text-[#623A2D]/80">
        <i class="fa-solid fa-code text-[#D09AFC]"></i>
        <span>Використовую перевірені інструменти індустрії:</span>
      </div>
      <div class="flex flex-wrap gap-2" data-animate="zoom-in" data-stagger>
        {technologies.map((tech) => (
          <span class="px-3 py-1 bg-white border border-[#623A2D]/10 rounded-[8px] text-xs font-black text-[#2A1E1E] shadow-2xs">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </section>
)}
