---
import Card from '../../../shared/components/ui/Card.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

export interface GuideItem {
  planName: string;
  badge?: string;
  recommendation?: string;
  reasons: string[];
}

interface Props {
  guide?: GuideItem[];
}

const { guide = [] } = Astro.props;
---

{guide && guide.length > 0 && (
  <section class="space-y-6 w-full" data-animate="fade-up">
    <SectionHeader
      title="Як обрати потрібний тариф?"
      subtitle="Орієнтири, що допоможуть швидко підібрати рішення під вашу ціль."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6" data-animate="fade-up" data-stagger>
      {guide.map((item) => (
        <Card class="p-6 space-y-4 bg-white border border-[#623A2D]/10">
          <div class="space-y-1 pb-3 border-b border-[#623A2D]/10">
            <h3 class="text-base font-black text-[#2A1E1E] m-0">
              {item.planName}
            </h3>
            {item.recommendation && (
              <p class="text-xs text-[#623A2D]/80 font-medium m-0 leading-relaxed">
                {item.recommendation}
              </p>
            )}
          </div>

          <ul class="space-y-2.5 list-none p-0 m-0">
            {item.reasons.map((reason) => (
              <li class="flex items-start gap-2.5 text-xs font-bold text-[#2A1E1E]/90 leading-snug">
                <i class="fa-solid fa-arrow-right text-[#95553C] text-[10px] mt-1 shrink-0"></i>
                <span>{reason}</span>
              </li>
            ))}
          </ul>
        </Card>
      ))}
    </div>
  </section>
)}

