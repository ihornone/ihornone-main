---
import Card from '../../../shared/components/ui/Card.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

export interface GuideItem {
  planName: string;
  badge: string;
  recommendation: string;
  reasons: string[];
}

interface Props {
  guide?: GuideItem[];
}

const { guide = [] } = Astro.props;
---

{guide && guide.length > 0 && (
  <section class="space-y-6 w-full" data-animate="fade-up">
    <SectionHeader
      title="Не впевнені, який тариф обрати?"
      subtitle="Простий гід під ваші бізнес-цілі та бюджет, який допоможе визначитись за 1 хвилину."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6" data-animate="fade-up" data-stagger>
      {guide.map((item, idx) => (
        <Card class="flex flex-col justify-between p-6 space-y-4 bg-white border border-[#623A2D]/10 hover:border-[#D09AFC] transition-all">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-[6px] bg-[#D09AFC]/20 text-[#623A2D]">
                {item.badge}
              </span>
              <span class="text-xs font-bold text-[#623A2D]/60">Варіант 0{idx + 1}</span>
            </div>

            <h3 class="text-base sm:text-lg font-black text-[#2A1E1E] m-0">
              Обирайте {item.planName}, якщо:
            </h3>

            <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium m-0 leading-relaxed">
              {item.recommendation}
            </p>

            <ul class="space-y-2 pt-2 border-t border-[#623A2D]/10 list-none p-0 m-0">
              {item.reasons.map((reason) => (
                <li class="flex items-start gap-2 text-xs font-semibold text-[#2A1E1E]/90 leading-snug">
                  <i class="fa-solid fa-arrow-right text-[#95553C] text-[10px] mt-0.5 shrink-0"></i>
                  <span>{reason}</span>
                </li>
              ))}
            </ul>
          </div>
        </Card>
      ))}
    </div>

    <!-- Free Consultation Banner -->
    <div class="p-4 sm:p-5 rounded-[10px] bg-[#FAF1EC] border border-[#623A2D]/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[10px] bg-white border border-[#623A2D]/10 flex items-center justify-center text-[#95553C] shrink-0 text-base shadow-2xs">
          <i class="fa-solid fa-lightbulb"></i>
        </div>
        <div>
          <h4 class="text-sm font-black text-[#2A1E1E] m-0">Потрібна допомога з вибором?</h4>
          <p class="text-xs text-[#623A2D]/80 font-medium m-0">Опишіть вашу ідею в Telegram — я безкоштовно оціню обсяг робіт і підкажу мінімально достатній тариф без переплат.</p>
        </div>
      </div>
      <a
        href="https://t.me/ihornone?text=Привіт!%20Допоможи,%20будь%20ласка,%20обрати%20тариф%20для%20мого%20проєкту."
        target="_blank"
        rel="noopener noreferrer"
        class="pill-btn-outline !py-2.5 !px-5 text-xs font-black shrink-0 self-start sm:self-auto flex items-center gap-2"
      >
        <i class="fa-brands fa-telegram text-sm"></i>
        <span>Отримати пораду</span>
      </a>
    </div>
  </section>
)}
