---
import Card from '../../../shared/components/ui/Card.astro';
import IconBox from '../../../shared/components/ui/IconBox.astro';
import SectionHeader from '../../../shared/components/ui/SectionHeader.astro';

interface IncludeItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  includes: IncludeItem[];
}

const { includes } = Astro.props;
---

<section class="space-y-6 w-full" data-animate="fade-up">
  <SectionHeader
    title="Що входить у послугу"
    subtitle="Ключові можливості та функціонал, які ви отримаєте в результаті."
  />
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5 sm:gap-6" data-animate="fade-up" data-stagger>
    {includes.map((item) => (
      <Card hover class="flex flex-col justify-between space-y-4">
        <IconBox icon={item.icon} />
        <div class="space-y-1.5">
          <h3 class="text-lg font-black text-[#2A1E1E] m-0">{item.title}</h3>
          <p class="text-xs sm:text-sm text-[#623A2D]/80 font-medium m-0 leading-relaxed">{item.description}</p>
        </div>
      </Card>
    ))}
  </div>
</section>
