---
import Card from '../../../shared/components/ui/Card.astro';

interface WorkflowStep {
  step: string;
  title: string;
  desc: string;
}

interface Props {
  steps?: WorkflowStep[];
  class?: string;
}

const defaultSteps: WorkflowStep[] = [
  {
    step: '01',
    title: 'Аналіз і ТЗ',
    desc: 'Обговорюємо вашу ідею, визначаємо бізнес-цілі та формуємо чітке технічне завдання з кошторисом.'
  },
  {
    step: '02',
    title: 'Архітектура та Прототип',
    desc: 'Проєктую базу даних, логіку взаємодії користувача з ботом чи сайтом та сценарії.'
  },
  {
    step: '03',
    title: 'Розробка та Інтеграція',
    desc: 'Пишу чистий код, інтегрую платіжні системи, API, CRM та налаштовую всю функціональність.'
  },
  {
    step: '04',
    title: 'Тестування і Запуск',
    desc: 'Проводжу повне тестування сценаріїв, деплою на ваш сервер та передаю документацію.'
  },
];

const { steps = defaultSteps, class: className = '' } = Astro.props;
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <div class="space-y-2 text-center max-w-xl mx-auto">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#E8BA98] text-[#2A1E1E] shadow-2xs">
      <i class="fa-solid fa-list-check text-xs"></i>
      Процес
    </span>
    <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
      Як ми працюємо
    </h2>
    <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium m-0">
      Зрозумілий та прозорий процес розробки на кожному етапі без сюрпризів.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6" data-animate="fade-up" data-stagger>
    {steps.map((item) => (
      <Card hover class="space-y-3 relative overflow-hidden h-full flex flex-col justify-start">
        <span class="text-2xl sm:text-3xl font-black text-[#D09AFC] tracking-tight block">
          {item.step}
        </span>
        <h3 class="text-base font-black text-[#2A1E1E] m-0">{item.title}</h3>
        <p class="text-xs sm:text-sm text-[#623A2D]/75 font-medium leading-relaxed m-0 flex-1">{item.desc}</p>
      </Card>
    ))}
  </div>
</section>
