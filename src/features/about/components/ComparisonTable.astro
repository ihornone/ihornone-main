---
interface CellData {
  text: string;
  status: 'good' | 'neutral';
}

interface ComparisonRow {
  feature: string;
  me: CellData;
  agency: CellData;
  freelancer: CellData;
}

interface Props {
  class?: string;
}

const comparisonRows: ComparisonRow[] = [
  {
    feature: 'Рівень інженерії та дизайн',
    me: { text: 'Агентський рівень', status: 'good' },
    agency: { text: 'Агентський рівень', status: 'good' },
    freelancer: { text: 'Залежить від навичок', status: 'neutral' },
  },
  {
    feature: 'Вартість проєкту',
    me: { text: 'Чесна ціна (без націнок)', status: 'good' },
    agency: { text: 'Висока (офіс + менеджери)', status: 'neutral' },
    freelancer: { text: 'Низька або плаваюча', status: 'neutral' },
  },
  {
    feature: 'Швидкість запуску MVP',
    me: { text: '14–28 днів', status: 'good' },
    agency: { text: '1.5–3 місяці', status: 'neutral' },
    freelancer: { text: 'Непередбачувано', status: 'neutral' },
  },
  {
    feature: 'Комунікація',
    me: { text: 'Прямо з автором коду', status: 'good' },
    agency: { text: 'Через менеджера (PM)', status: 'neutral' },
    freelancer: { text: 'Прямий контакт', status: 'good' },
  },
  {
    feature: 'Робота під ключ (дизайн + код)',
    me: { text: 'Повний цикл від ідеї до релізу', status: 'good' },
    agency: { text: 'Повний цикл від ідеї до релізу', status: 'good' },
    freelancer: { text: 'Часто лише окрема частина', status: 'neutral' },
  },
  {
    feature: 'Гарантійна підтримка',
    me: { text: '30 днів включено', status: 'good' },
    agency: { text: 'За окремим контрактом', status: 'neutral' },
    freelancer: { text: 'За домовленістю', status: 'neutral' },
  },
  {
    feature: 'Контроль та вихідний код',
    me: { text: 'Ваш приватний Git з 1-го дня', status: 'good' },
    agency: { text: 'Корпоративний репозиторій', status: 'good' },
    freelancer: { text: 'За домовленістю', status: 'neutral' },
  },
];

const { class: className = '' } = Astro.props;
---

<section class:list={['space-y-8 w-full', className]} data-animate="fade-up">
  <div class="space-y-2 text-center max-w-xl mx-auto">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#D09AFC] text-[#2A1E1E] shadow-2xs">
      <i class="fa-solid fa-scale-balanced text-xs"></i>
      Порівняння форматів
    </span>
    <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
      Якість агентства — вигода прямого розробника
    </h2>
    <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium m-0">
      Агентський рівень дизайну та інженерії без переплат за зайві ланки та офіси.
    </p>
  </div>

  <div class="bento-card p-0 overflow-hidden shadow-2xs" data-animate="fade-up">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[640px]">
        <thead>
          <tr class="border-b border-[#623A2D]/10 bg-[#FAF1EC]/60">
            <th class="p-4 sm:p-5 font-black text-[#2A1E1E] w-[28%]">Критерій</th>
            <th class="p-4 sm:p-5 font-black text-[#2A1E1E] text-left bg-[#D09AFC]/15 w-[26%]">
              <span class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-[#2A1E1E]">
                <i class="fa-solid fa-cat text-[#2A1E1E]"></i> ihornone (розробник)
              </span>
            </th>
            <th class="p-4 sm:p-5 font-bold text-[#623A2D]/80 text-left w-[23%]">Digital-агентства</th>
            <th class="p-4 sm:p-5 font-bold text-[#623A2D]/80 text-left w-[23%]">Фрилансери</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#623A2D]/10">
          {comparisonRows.map((row) => (
            <tr class="hover:bg-[#FAF1EC]/30 transition-colors">
              <td class="p-4 sm:p-5 font-black text-[#2A1E1E] align-middle">
                {row.feature}
              </td>
              
              <!-- ihornone -->
              <td class="p-4 sm:p-5 bg-[#D09AFC]/10 align-middle">
                <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-black text-[#2A1E1E]">
                  <span class="w-5 h-5 rounded-full bg-[#D09AFC] text-[#2A1E1E] flex items-center justify-center text-[11px] shrink-0 shadow-2xs">
                    <i class="fa-solid fa-check"></i>
                  </span>
                  <span>{row.me.text}</span>
                </div>
              </td>

              <!-- agency -->
              <td class="p-4 sm:p-5 align-middle">
                <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-[#2A1E1E]">
                  {row.agency.status === 'good' ? (
                    <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-[11px] shrink-0">
                      <i class="fa-solid fa-check"></i>
                    </span>
                  ) : (
                    <span class="w-5 h-5 rounded-full bg-[#FAF1EC] border border-[#623A2D]/15 text-[#623A2D] flex items-center justify-center text-[10px] shrink-0">
                      <i class="fa-solid fa-minus"></i>
                    </span>
                  )}
                  <span>{row.agency.text}</span>
                </div>
              </td>

              <!-- freelancer -->
              <td class="p-4 sm:p-5 align-middle">
                <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-[#623A2D]/80">
                  {row.freelancer.status === 'good' ? (
                    <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-[11px] shrink-0">
                      <i class="fa-solid fa-check"></i>
                    </span>
                  ) : (
                    <span class="w-5 h-5 rounded-full bg-[#FAF1EC] border border-[#623A2D]/15 text-[#623A2D] flex items-center justify-center text-[10px] shrink-0">
                      <i class="fa-solid fa-minus"></i>
                    </span>
                  )}
                  <span>{row.freelancer.text}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
