---
interface TechItem {
  name: string;
  category: string;
  icon: string;
  badge: string;
  desc: string;
}

interface Props {
  class?: string;
}

const technologies: TechItem[] = [
  {
    name: 'React & Next.js',
    category: 'Web',
    icon: 'fa-brands fa-react',
    badge: 'Frontend',
    desc: 'Сучасні веб-інтерфейси, особисті кабінети та високошвидкісні сервіси.',
  },
  {
    name: 'TypeScript',
    category: 'Мова',
    icon: 'fa-solid fa-code',
    badge: 'Надійність',
    desc: 'Сувора типізація для стабільного коду без прихованих багів у продакшені.',
  },
  {
    name: 'Astro & Tailwind CSS',
    category: 'Web & UI',
    icon: 'fa-solid fa-rocket',
    badge: '100/100 Speed',
    desc: 'Ультрашвидкі лендінги та адаптивний дизайн під будь-які екрани.',
  },
  {
    name: 'React Native & Expo',
    category: 'Mobile',
    icon: 'fa-solid fa-mobile-screen-button',
    badge: 'iOS & Android',
    desc: 'Єдина кодова база для двох платформ: швидкий запуск та економія бюджету.',
  },
  {
    name: 'Telegram Mini Apps & Боти',
    category: 'Telegram',
    icon: 'fa-brands fa-telegram',
    badge: 'aiogram 3 / WebApp',
    desc: 'Автоматизація бізнесу, прийом замовлень та боти з веб-інтерфейсом прямо в чаті.',
  },
  {
    name: 'Node.js & Python (FastAPI)',
    category: 'Backend',
    icon: 'fa-brands fa-node-js',
    badge: 'REST API',
    desc: 'Швидка та масштабована серверна логіка, мікросервіси та обробка вебхуків.',
  },
  {
    name: 'PostgreSQL & Redis',
    category: 'Бази даних',
    icon: 'fa-solid fa-database',
    badge: 'ACID / Кеш',
    desc: 'Надійне збереження даних, захист транзакцій та миттєвий відгук систем.',
  },
  {
    name: 'Платіжні системи & API',
    category: 'Fintech',
    icon: 'fa-solid fa-credit-card',
    badge: 'Mono / LiqPay / WayForPay',
    desc: 'Прийом оплат картками, Apple Pay, Google Pay, QR-коди та автофіскалізація.',
  },
];

const { class: className = '' } = Astro.props;
---

<section id="tech-stack" class:list={['space-y-6 sm:space-y-8 w-full', className]} data-animate="fade-up">
  
  <!-- Section Title -->
  <div class="space-y-2 text-center max-w-xl mx-auto">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#FAC3C8] text-[#2A1E1E] shadow-2xs">
      <i class="fa-solid fa-code text-xs"></i>
      Стек технологій
    </span>
    <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
      Технології, з якими я працюю
    </h2>
    <p class="text-sm sm:text-base text-[#623A2D]/80 font-medium m-0">
      Перевірений сучасний стек для швидких сайтів, надійних ботів та мобільних додатків.
    </p>
  </div>

  <!-- Clean, Simple 4-in-a-row Grid -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4"
    data-animate="fade-up"
    data-stagger
  >
    {technologies.map((t) => (
      <div class="bg-white border border-[#623A2D]/10 rounded-[10px] p-4 sm:p-5 flex flex-col justify-between space-y-3 transition-all duration-200 hover:border-[#D09AFC] hover:shadow-sm">
        <div class="space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <div class="w-9 h-9 rounded-[10px] bg-[#FAF1EC] border border-[#623A2D]/10 flex items-center justify-center text-base text-[#2A1E1E] shadow-2xs">
              <i class={t.icon}></i>
            </div>
            <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-[6px] bg-[#FAF1EC] border border-[#623A2D]/10 text-[#623A2D]">
              {t.badge}
            </span>
          </div>

          <h3 class="text-base font-black text-[#2A1E1E] tracking-tight m-0">
            {t.name}
          </h3>

          <p class="text-xs sm:text-sm text-[#623A2D]/75 font-medium leading-relaxed m-0">
            {t.desc}
          </p>
        </div>

        <div class="pt-2 border-t border-[#623A2D]/10 flex items-center justify-between text-[11px] font-bold text-[#623A2D]/60">
          <span>{t.category}</span>
          <i class="fa-solid fa-check text-[#95553C] text-[10px]"></i>
        </div>
      </div>
    ))}
  </div>

</section>
