---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import Stats from '../shared/components/sections/Stats.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import Button from '../shared/components/ui/Button.astro';
import { WhyMe, ComparisonTable, CodeGuarantee, FeaturedWorks, TechStack, Workflow } from '../features/about';

const stats = [
  {
    value: '15+',
    label: 'реалізованих рішень',
    subtext: 'сайти, боти та застосунки',
    link: { text: 'Дивитись кейси в портфоліо', href: '/portfolio' },
  },
  {
    value: '3+',
    label: 'роки досвіду',
    subtext: 'Full-Stack розробки',
  },
  {
    value: '14–28',
    label: 'днів на запуск MVP',
    subtext: 'від ТЗ до перших клієнтів',
  },
  {
    value: '30 днів',
    label: 'гарантійної підтримки',
    subtext: 'безкоштовні фікси після релізу',
  },
];
---

<Layout
  title="Про мене — ihornone | Full-Stack розробник Telegram-ботів та веб-сайтів"
  description="Досвідчений full-stack розробник. Створюю Telegram-боти, мобільні додатки та веб-сайти з гарантією на код та прозорими строками."
  url="/about"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "ihornone",
      "jobTitle": "Full-Stack Developer",
      "description": "Full-stack розробник з 3+ роками досвіду. Розробка Telegram-ботів з оплатою, кросплатформних мобільних додатків та веб-сайтів для бізнесу.",
      "knowsAbout": ["Telegram Bots", "Astro", "React Native", "TypeScript", "Node.js", "Python", "Full-Stack Web Development"],
      "sameAs": [
        "https://t.me/ihornone",
        "https://github.com/ihornone",
        "https://instagram.com/ihornone",
        "https://threads.net/@ihornone"
      ]
    }
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 md:space-y-24">
    <Hero
      badge={{ text: 'Сайти • Telegram-боти • Мобільні додатки', icon: 'fa-solid fa-layer-group' }}
      title="Розробляю сайти, Telegram-боти та мобільні застосунки для бізнесу"
      subtitle="Працюю напряму з вами: від ідеї та архітектури до чистого коду, запуску й 30 днів гарантійної підтримки. Без націнок агентств, черг та посередників."
      buttons={[
        { label: "Обговорити проєкт", href: '/contacts', variant: 'dark', icon: 'fa-solid fa-arrow-right' },
        { label: 'Переглянути портфоліо', href: '/portfolio', variant: 'outline' },
      ]}
    />

    <!-- Чому обирають мене -->
    <WhyMe />

    <!-- Живі докази: ключові кейси -->
    <FeaturedWorks />

    <!-- Я vs Агентства vs Інші фрилансери -->
    <ComparisonTable />

    <!-- Деталізація гарантії на код (30 днів) -->
    <CodeGuarantee />

    <!-- Стек технологій -->
    <TechStack />

    <!-- Етапи розробки -->
    <Workflow />

    <!-- Статистика -->
    <Stats items={stats} columns={4} />

    <!-- Bento CTA with Mascot -->
    <BentoCta />
  </div>
</Layout>
