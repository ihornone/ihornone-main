---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import ServiceFaq from '../shared/components/sections/ServiceFaq.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import { PortfolioFilterGrid } from '../features/portfolio';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('projects');

const allProjects = allEntries
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    category: entry.data.category,
    icon: entry.data.icon,
    image: entry.data.image,
    description: entry.data.description,
    pinned: entry.data.pinned,
    order: entry.data.order,
    statusBadge: entry.data.statusBadge,
    clientName: entry.data.clientName,
    meta: {
      technologies: entry.data.technologies,
    },
  }))
  .sort((a, b) => {
    const pinA = Boolean(a.pinned);
    const pinB = Boolean(b.pinned);
    if (pinA && !pinB) return -1;
    if (!pinA && pinB) return 1;

    const orderA = a.order ?? (typeof a.pinned === 'number' ? a.pinned : 99);
    const orderB = b.order ?? (typeof b.pinned === 'number' ? b.pinned : 99);
    return orderA - orderB;
  });

const categories = ['Усі проєкти', ...new Set(allProjects.map((p) => p.category))];
---

<Layout
  title="Портфоліо — Приклади розроблених проєктів | ihornone"
  description="Приклади розроблених веб-сайтів, мобільних додатків та Telegram-ботів з реальними бізнес-результатами та метриками."
  url="/portfolio"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <Hero
      badge={{ text: 'Портфоліо робіт', icon: 'fa-solid fa-briefcase' }}
      title="Реалізовані проєкти та кейси"
      subtitle="Приклади розроблених Telegram-ботів, мобільних додатків та веб-сайтів. Кожен проєкт реалізовано під конкретні бізнес-завдання."
    />

    <PortfolioFilterGrid categories={categories} projects={allProjects} />

    <ServiceFaq />
    
    <!-- Bento CTA with Mascot -->
    <BentoCta />
  </div>
</Layout>
