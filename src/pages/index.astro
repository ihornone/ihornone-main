---
import Layout from '../layouts/Layout.astro';
import FullscreenHero from '../shared/components/sections/FullscreenHero.astro';
import BentoServices from '../shared/components/sections/BentoServices.astro';
import TurboComparison from '../shared/components/sections/TurboComparison.astro';
import SpecializationGrid from '../shared/components/sections/SpecializationGrid.astro';
import ServiceFaq from '../shared/components/sections/ServiceFaq.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import ProjectCard from '../features/portfolio/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('projects');
const featuredProjects = allEntries.slice(0, 3).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  category: entry.data.category,
  icon: entry.data.icon,
  image: entry.data.image,
  description: entry.data.description,
  meta: {
    technologies: entry.data.technologies,
  },
}));
---

<Layout
  title="ihornone — Telegram-боти, Веб-сайти, Мобільні додатки | Full-Stack Розробка"
  description="Розробка Telegram-ботів, мобільних додатків та веб-сайтів будь-якої складності. Повний цикл від ідеї до запуску з високою конверсією."
  url="/"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "ihornone",
    "description": "Розробка Telegram-ботів, мобільних додатків та веб-сайтів",
    "url": "https://ihornone.site",
    "telephone": "+380",
    "priceRange": "$$",
    "areaServed": "UA",
    "knowsAbout": ["Telegram Bots", "Web Development", "Mobile Apps", "React Native", "Node.js", "Python"],
    "sameAs": [
      "https://t.me/ihornone",
      "https://github.com/ihornone",
      "https://instagram.com/ihornone"
    ]
  }}
>
  <!-- Full-screen Cinematic Hero Section -->
  <FullscreenHero />

  <!-- Main Bento Page Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-20 space-y-20 sm:space-y-28">
    
    <!-- 3 Big Superpowers (Services Bento) -->
    <BentoServices />

    <!-- Turbo vs Agency Value Comparison -->
    <TurboComparison />

    <!-- Detailed Tech Specializations Grid -->
    <section class="space-y-6 sm:space-y-8" data-animate="fade-up">
      <div class="space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#D09AFC] text-[#2A1E1E] shadow-2xs">
          <i class="fa-solid fa-microchip text-xs"></i>
          Експертиза & Інтеграції
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
          Спеціалізація та готові модулі
        </h2>
        <p class="text-sm sm:text-base text-[#623A2D]/80 max-w-xl m-0 font-medium">
          Архітектурні рішення, які я щодня використовую для створення масштабованих продуктів.
        </p>
      </div>

      <SpecializationGrid />
    </section>

    <!-- Featured Projects Showcase -->
    <section class="space-y-8 sm:space-y-10 w-full" data-animate="fade-up">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="space-y-2">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#E8BA98] text-[#2A1E1E] shadow-2xs">
            <i class="fa-solid fa-briefcase text-xs"></i>
            Реалізовані кейси
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
            Останні реалізовані проєкти
          </h2>
          <p class="text-sm sm:text-base text-[#623A2D]/80 max-w-xl m-0 font-medium">
            Працюючі продукти для бізнесу з реальними цифрами та вимірюваним результатом.
          </p>
        </div>

        <a
          href="/portfolio"
          class="pill-btn-outline !py-2.5 !px-5 text-xs font-bold self-start md:self-auto shrink-0 flex items-center gap-2"
        >
          <span>Усі проєкти</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="space-y-6 sm:space-y-8" data-animate="fade-up">
      <div class="space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-[10px] text-xs font-black uppercase tracking-wider bg-[#FAC3C8] text-[#2A1E1E] shadow-2xs">
          <i class="fa-solid fa-circle-question text-xs"></i>
          Запитання та відповіді
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-[#2A1E1E] tracking-tight m-0">
          Часті запитання клієнтів
        </h2>
        <p class="text-sm sm:text-base text-[#623A2D]/80 max-w-xl m-0 font-medium">
          Відповіді на головні питання щодо термінів, оплати, передачі прав та підтримки.
        </p>
      </div>

      <ServiceFaq globalOnly showHeader={false} />
    </section>

    <!-- Clean CTA Banner -->
    <BentoCta />

  </div>
</Layout>
