---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import BentoCta from '../shared/components/sections/BentoCta.astro';
import { ReviewsMasonry } from '../features/reviews';

const imageModules = import.meta.glob('/src/content/reviews/*.{png,jpg,jpeg,webp,avif,gif}', { eager: true, query: '?url', import: 'default' });
const images = Object.values(imageModules) as string[];
---

<Layout
  title="Відгуки — Що кажуть клієнти | ihornone"
  description="Відгуки клієнтів про співпрацю з розробником Telegram-ботів, мобільних додатків та веб-сайтів."
  url="/reviews"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": "Відгуки про роботу з ihornone",
    "description": "Скріншоти та реальні відгуки клієнтів про створені Telegram-боти, сайти та застосунки",
    "url": "https://ihornone.site/reviews"
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-2 sm:pt-4 pb-16 sm:pb-24 space-y-16 sm:space-y-24">
    <Hero
      badge={{ text: 'Відгуки клієнтів', icon: 'fa-solid fa-star' }}
      title="Що кажуть мої клієнти"
      subtitle="Реальні відгуки від людей, з якими я мав задоволення працювати над їхніми проєктами."
    />

    <ReviewsMasonry images={images} />

    <!-- Bento CTA with Mascot -->
    <BentoCta />
  </div>
</Layout>

