---
import Layout from '../layouts/Layout.astro';
import Hero from '../shared/components/sections/Hero.astro';
import CtaBanner from '../shared/components/sections/CtaBanner.astro';

const imageModules = import.meta.glob('/src/content/reviews/*.{png,jpg,jpeg,webp,avif,gif}', { eager: true, query: '?url', import: 'default' });
const images = Object.values(imageModules) as string[];
---

<Layout
  title="Відгуки — Що кажуть клієнти | ihornone"
  description="Відгуки клієнтів про співпрацю з розробником Telegram-ботів, мобільних додатків та веб-сайтів."
  url="/reviews"
>
  <Hero
    badge={{ text: 'Відгуки клієнтів', icon: 'fa-solid fa-star' }}
    title="Що кажуть мої клієнти"
    subtitle="Реальні відгуки від людей, з якими я мав задоволення працювати над їхніми проєктами."
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12">

    {images.length > 0 ? (
      <div class="masonry-grid" data-animate="fade-up" data-stagger>
        {images.map((src) => (
          <div class="masonry-item break-inside-avoid mb-4">
            <img
              src={src}
              alt=""
              class="w-full rounded-2xl object-cover cursor-pointer hover:scale-[1.02] transition-transform duration-300"
              loading="lazy"
              data-lightbox
            />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-black/40 text-sm">Додайте фото до папки src/content/reviews/</p>
    )}

  </div>

  <CtaBanner />

  <dialog id="lightbox" class="fixed inset-0 z-[200] bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full opacity-0 pointer-events-none backdrop:bg-black/80">
    <button id="lightbox-close" class="fixed top-4 right-4 z-[201] w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-xl flex items-center justify-center cursor-pointer border-none transition-colors" aria-label="Закрити">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg mx-auto my-auto" />
  </dialog>
</Layout>

<style>
  .masonry-grid {
    column-count: 1;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      column-count: 3;
    }
  }

  #lightbox[open] {
    opacity: 1;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('lightbox-close');

    document.querySelectorAll('[data-lightbox]').forEach((el) => {
      el.addEventListener('click', () => {
        img.src = (el as HTMLImageElement).src;
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
