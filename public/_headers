# Static assets (hashed files from build, fonts, CSS) - cache forever in browser and Cloudflare CDN
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Public static images - cache for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Public SVG icons
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML pages - instant CDN edge delivery with background revalidation
/*
  Cache-Control: public, max-age=0, must-revalidate
